# Copy to .env.local for local runs. Set the same four values in Vercel's
# Environment Variables UI (Production + Preview + Development) for the hosted app.
#
# All four are OPTIONAL: without them the app still runs, fully offline, saving
# everything to the browser's local storage. They only enable Google Sheets sync.

# Service account email, e.g. draft-writer@my-project.iam.gserviceaccount.com
GOOGLE_SA_EMAIL=

# The service account's private key, base64-encoded (avoids newline mangling).
# Generate it from the downloaded JSON key with:
#   node -e "console.log(Buffer.from(require('./key.json').private_key).toString('base64'))"
GOOGLE_SA_PRIVATE_KEY_B64=

# From the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEETS_SPREADSHEET_ID=

# Any long random string. The app asks for it once on the setup screen.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_WRITE_TOKEN=
